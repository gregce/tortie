.tmp/
.antigravitycli/
# Phase 15: the vendored specstory-cli release (41 MB Mach-O + its tarball
# cache). Reproduced from the pin in build/specstory-release.json by
# build/fetch-specstory.cjs — never committed.
build/vendor/

# Generated BY Tortie itself, by the Architecture feature, from whatever tree it
# is opened on. It is output rather than a source document: it goes stale the
# moment the tree moves, and checking it in would commit a snapshot the app
# rewrites. A repository that WANTS a standing contract commits its own.
docs/arch/
