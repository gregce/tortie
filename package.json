{
  "name": "gmux",
  "version": "0.0.1",
  "description": "Lightweight macOS shell for agentic coding: durable named terminal sessions (private tmux server), git sidebar, decorated file tree, diff + edit surfaces.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "SpecStory",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke": "npm run build && GMUX_SMOKE=basic electron .",
    "smoke:create": "GMUX_SMOKE=create electron .",
    "smoke:verify": "GMUX_SMOKE=verify electron .",
    "smoke:t1": "npm run build && GMUX_SMOKE=create electron . && GMUX_SMOKE=verify electron .",
    "smoke:t3": "npm run build && GMUX_SMOKE=t3-prep electron . && GMUX_SMOKE=t3-verify electron .",
    "smoke:identity": "npm run build && GMUX_SMOKE=identity electron . --user-data-dir=\"${TMPDIR:-/tmp/}gmux-smoke-identity\"",
    "test": "vitest run",
    "shot": "npm run build && GMUX_SHOT=\"${GMUX_SHOT:-out/gmux-shot.png}\" electron .",
    "start": "electron-vite preview",
    "postinstall": "electron-rebuild -f -w node-pty,better-sqlite3",
    "package": "electron-vite build && electron-builder --mac",
    "package:dir": "electron-vite build && electron-builder --mac --dir",
    "icon": "cd build && rm -rf icon.iconset icon.icns && mkdir -p icon.iconset && for s in 16 32 128 256 512; do rsvg-convert -w $s -h $s icon.svg -o icon.iconset/icon_${s}x${s}.png; rsvg-convert -w $((s*2)) -h $((s*2)) icon.svg -o icon.iconset/icon_${s}x${s}@2x.png; done && iconutil -c icns icon.iconset -o icon.icns && rm -rf icon.iconset"
  },
  "dependencies": {
    "@parcel/watcher": "^2.6.0",
    "@pierre/diffs": "1.3.5",
    "@pierre/trees": "1.0.0-beta.6",
    "@shikijs/rehype": "4.4.3",
    "@vscode/codicons": "^0.0.46-24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "material-icon-theme": "^5.37.0",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.10"
  }
}
