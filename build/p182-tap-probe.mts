/**
 * `npm run probe:p182` — the live proof of the status line tap (Phase 182).
 *
 * WHAT IT PROVES THAT NOTHING ELSE CAN. Every other check in this phase runs
 * Tortie's own bytes against Tortie's own fixtures. This one puts the REAL
 * claude binary in the loop: it writes the settings file and the managed
 * script exactly as src/main writes them, launches `claude --settings <file>`
 * in a tmux pane stamped the way `paneEnvFor` stamps one, spends ONE short
 * turn, and reads what arrives on a real loopback server. Then it feeds that
 * body through the phase's own reader and the real usage service, whose
 * transport and credential reader both THROW, so a number on the meter can
 * only have come from the tap.
 *
 * WHAT IT COSTS: one claude process and one real turn on the person's own
 * subscription window, a three word prompt answered in a word.
 *
 * WHAT IT NEVER DOES: it reads no credential, prints no usage VALUE, touches
 * no file under `~/.claude`, and uses a tmux socket and a scratch directory of
 * its own which it removes in a `finally` block whatever happened. It launches
 * no Electron.
 *
 *     npm run probe:p182
 */

import { spawnSync } from 'node:child_process';
import { createServer, type Server } from 'node:http';
import {
  chmodSync,
  mkdirSync,
  mkdtempSync,
  rmSync,
  writeFileSync
} from 'node:fs';
import { randomBytes, randomUUID } from 'node:crypto';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import {
  claudeStatusLineScript,
  parseTapBody,
  statusLineBlock,
  tapConfigKey
} from '../src/main/usage/statusline';
import { createUsageService } from '../src/main/usage/service';

const SOCKET = `p182-tap-${process.pid}`;
const SESSION_ID = randomUUID();
const TOKEN = randomBytes(16).toString('hex');
const PROMPT = 'reply with ok';

const failures: string[] = [];
const check = (ok: boolean, line: string): void => {
  console.log(`${ok ? '  ok  ' : ' FAIL '} ${line}`);
  if (!ok) failures.push(line);
};

function tmux(...args: string[]): string {
  const res = spawnSync('tmux', ['-L', SOCKET, ...args], { encoding: 'utf8' });
  return `${res.stdout ?? ''}${res.stderr ?? ''}`;
}

const sleep = (ms: number): Promise<void> =>
  new Promise((r) => setTimeout(r, ms));

async function main(): Promise<void> {
  // A scratch directory of this probe's own. `P182_DIR` lets a caller put it
  // somewhere it can watch; the default is the machine's temporary directory.
  // A FIXED name under P182_DIR when one is given, and a fresh one otherwise.
  // The fixed name is deliberate: claude records workspace trust per PATH, so
  // one stable path means this probe answers the trust question once ever
  // rather than adding an entry to the person's config on every run.
  const root = process.env['P182_DIR'];
  let dir: string;
  if (root === undefined) {
    dir = mkdtempSync(join(tmpdir(), 'p182-probe-'));
  } else {
    dir = join(root, 'p182-probe');
    mkdirSync(dir, { recursive: true });
  }
  const settingsDir = join(dir, 'claude');
  const stampDir = join(settingsDir, 'stamps');
  mkdirSync(stampDir, { recursive: true });
  let server: Server | null = null;
  const posts: { path: string; body: string }[] = [];

  try {
    // 1. The managed script, Tortie's own generated bytes.
    const script = join(settingsDir, 'tortie-statusline.sh');
    writeFileSync(script, claudeStatusLineScript({ settingsDir, stampDir }));
    chmodSync(script, 0o755);

    // 2. The loopback server, on an ephemeral port, 127.0.0.1 only.
    server = createServer((req, res) => {
      let body = '';
      req.on('data', (c: Buffer) => {
        body += c.toString('utf8');
      });
      req.on('end', () => {
        posts.push({ path: req.url ?? '', body });
        res.statusCode = 200;
        res.end();
      });
    });
    const port = await new Promise<number>((resolve) => {
      server?.listen(0, '127.0.0.1', () =>
        resolve((server?.address() as { port: number }).port)
      );
    });
    console.log(`bound 127.0.0.1:${port}, socket ${SOCKET}`);

    // 3. The settings file, in the shape src/main/activity/hooks.ts writes.
    const base = `http://127.0.0.1:${port}`;
    const settingsFile = join(settingsDir, `${SESSION_ID}.json`);
    writeFileSync(
      settingsFile,
      JSON.stringify(
        {
          allowedHttpHookUrls: [`${base}/*`],
          hooks: {
            Stop: [{ hooks: [{ type: 'http', url: `${base}/h/${TOKEN}?e=Stop` }] }]
          },
          ...statusLineBlock(script)
        },
        null,
        2
      )
    );

    // 4. A pane stamped the way paneEnvFor stamps one, running real claude.
    tmux('kill-server');
    const out = tmux(
      'new-session',
      '-d',
      '-s',
      'p182',
      '-x',
      '200',
      '-y',
      '50',
      '-e',
      'GMUX_MANAGED=1',
      '-e',
      `GMUX_SESSION_ID=${SESSION_ID}`,
      '-c',
      dir,
      '--',
      'claude',
      '--settings',
      settingsFile
    );
    check(!out.includes('error'), `pane started (${out.trim() || 'no output'})`);

    // 5. Wait for the composer, answering the workspace trust question if it
    //    comes first. Research 72 section 10.7 failure mode 3: in a directory
    //    claude has not been trusted in, the trust question comes BEFORE the
    //    TUI and the status line is skipped until it is answered. A probe
    //    that typed its prompt into that question would answer "No, exit",
    //    which is what the first run of this probe did.
    let ready = false;
    let trusted = false;
    for (let i = 0; i < 60 && !ready; i += 1) {
      const pane = tmux('capture-pane', '-p', '-t', 'p182');
      if (!trusted && pane.includes('I trust this folder')) {
        tmux('send-keys', '-t', 'p182', 'Down');
        await sleep(400);
        tmux('send-keys', '-t', 'p182', 'Enter');
        trusted = true;
        await sleep(2000);
        continue;
      }
      // The composer's caret, which is on screen only once the TUI is drawn
      // and the trust question is gone.
      if (!pane.includes('Quick safety check') && pane.includes('\u276f')) {
        ready = true;
      } else {
        await sleep(1000);
      }
    }
    check(ready, `the composer is up${trusted ? ' (trust accepted)' : ''}`);
    if (!ready) return;

    // 6. One turn.
    tmux('send-keys', '-t', 'p182', PROMPT);
    await sleep(1500);
    tmux('send-keys', '-t', 'p182', 'Enter');

    // The settings file names BOTH a Stop hook and the status line, exactly
    // as Tortie's does, so this server sees both. The tap's own route is the
    // one being waited for; the hook post is noted because a run where only
    // the hook arrived is a turn that happened with no tap, which is a
    // different failure from a turn that never happened.
    const tapPath = `/u/${TOKEN}`;
    const deadline = Date.now() + 240_000;
    while (
      !posts.some((p) => p.path === tapPath) &&
      Date.now() < deadline
    ) {
      await sleep(1000);
    }
    console.log(`  posts: ${posts.map((p) => p.path.split('?')[0]).join(' ')}`);
    check(
      posts.some((p) => p.path.startsWith('/h/')),
      'the activity hook posted too, from the same settings file'
    );
    const post = posts.find((p) => p.path === tapPath);
    check(post !== undefined, 'a post arrived on the tap route');
    if (post === undefined) return;

    // 7. The pane is unchanged: no line from the script in it.
    const pane = tmux('capture-pane', '-p', '-t', 'p182');
    check(
      !pane.includes('tortie-statusline'),
      'the pane carries no line from the script'
    );

    // 8. The phase's own reader, over the real body.
    const now = Date.now();
    const sample = parseTapBody(post.body, now);
    check(sample !== null, 'the reader accepted the real body');
    check(sample?.sessionId === SESSION_ID, 'it carries the stamped session id');
    check(
      sample?.configKey === tapConfigKey(process.env['CLAUDE_CONFIG_DIR']),
      'its config key is this account'
    );
    const five = sample?.fiveHour;
    const seven = sample?.sevenDay;
    // The VALUES are the person's own usage and are never printed. Shape only.
    check(
      five !== null &&
        five !== undefined &&
        Number.isFinite(five.percent) &&
        five.percent >= 0 &&
        five.percent <= 100,
      'five_hour is a percentage in range'
    );
    check(
      five?.resetsAt !== null &&
        five?.resetsAt !== undefined &&
        five.resetsAt > now,
      'its reset is a future instant, so the seconds were read as seconds'
    );
    check(seven !== null && seven !== undefined, 'seven_day is present');

    // 9. The real service, with a transport and a credential reader that
    //    THROW. A number on the meter now can only be the tap's.
    const service = createUsageService({
      credentials: {
        keychain: () => {
          throw new Error('the keychain was opened');
        },
        readText: () => {
          throw new Error('a credentials file was read');
        },
        env: process.env,
        home: process.env['HOME'] ?? '/'
      },
      transport: () => {
        throw new Error('the endpoint was called');
      },
      settings: () => ({ claude: true, codex: false, bar: 'five-hour' }),
      now: () => now,
      log: () => undefined
    });
    const outcome = service.applyTap(SESSION_ID, post.body);
    check(outcome === 'applied', `the service applied it (${outcome})`);
    const row = service
      .current()
      .providers.find((p) => p.provider === 'claude');
    check(row?.state === 'ok', 'the claude row reads ok');
    check(row?.fiveHour !== null, 'the meter has a five hour number');
    const snap = await service.read();
    check(
      snap.providers.find((p) => p.provider === 'claude')?.state === 'ok',
      'a read right after it makes NO request, because the tap suppressed it'
    );
  } finally {
    // The server, the tmux server, its socket file and the scratch directory,
    // in that order and whatever happened above. None of these paths is under
    // anybody's home.
    tmux('kill-server');
    const uid = process.getuid?.() ?? 501;
    for (const root of ['/private/tmp', '/tmp']) {
      rmSync(join(root, `tmux-${uid}`, SOCKET), { force: true });
    }
    server?.close();
    rmSync(dir, { recursive: true, force: true });
  }
}

main()
  .then(() => {
    if (failures.length > 0) {
      console.error(`\np182: ${failures.length} failed`);
      process.exit(1);
    }
    console.log('\np182: the tap is live. One claude turn spent.');
  })
  .catch((err: unknown) => {
    console.error(err);
    process.exit(1);
  });
