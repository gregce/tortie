{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "rootDir": "src/shared",
    "outDir": ".tsc/shared",
    "tsBuildInfoFile": ".tsc/shared.tsbuildinfo"
  },
  "include": ["src/shared/**/*.ts"],
  "exclude": ["src/shared/__tests__/**", "src/shared/**/__tests__/**"]
}
